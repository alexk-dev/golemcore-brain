<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
        <Class name="~me\.golemcore\.brain\..*" />
    </Match>

    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
        <Not>
            <Class name="~me\.golemcore\.brain\.domain\.model\..*" />
        </Not>
    </Match>

    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION" />
        <Or>
            <Class name="~me\.golemcore\.brain\.adapter\..*" />
            <Class name="~me\.golemcore\.brain\.domain\.service\..*" />
        </Or>
    </Match>

    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
        <Or>
            <Class name="~me\.golemcore\.brain\.adapter\..*" />
            <Class name="~me\.golemcore\.brain\.domain\.service\..*" />
        </Or>
    </Match>

    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
        <Or>
            <Class name="~me\.golemcore\.brain\.adapter\..*" />
            <Class name="~me\.golemcore\.brain\.domain\.service\..*" />
        </Or>
    </Match>

    <!-- Spring Security's SecurityFilterChain @Bean signature mandates `throws Exception`. -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
        <Class name="me.golemcore.brain.config.SecurityConfig" />
    </Match>

    <!-- Header value is validated against [A-Za-z0-9._-]{0,64} before being echoed back; the
         regex eliminates the CRLF / control-char injection vector this rule guards against. -->
    <Match>
        <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER" />
        <Class name="me.golemcore.brain.web.RequestIdFilter" />
    </Match>

    <!-- Scheduler dispatch must restore coalescing state before propagating executor rejection. -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
        <Class name="me.golemcore.brain.application.service.index.WikiIndexingService" />
        <Method name="dispatchScheduledRebuild" />
    </Match>

    <!-- Path.getFileName() is flagged nullable but never null within DirectoryStream iteration -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
        <Class name="~me\.golemcore\.brain\.adapter\.out\.filesystem\..*" />
    </Match>

    <!-- Single-pass lookupPath string building; micro-optimization not worth refactoring -->
    <Match>
        <Bug pattern="SBSC_USE_STRINGBUFFER_CONCATENATION" />
        <Class name="me.golemcore.brain.application.service.WikiApplicationService" />
    </Match>
</FindBugsFilter>
